// fin-crypto example: hash a password, MAC a message, mint a token.
//
// Run: finc examples/basic.fin -I src -o basic && ./basic

import { sha256_hex, hmac_sha256_hex, random_hex, const_time_eq } from crypto::fin;

fun main() <noret> {
    // 1. Hash something.
    let digest <string> = sha256_hex("hello fin");
    printf("sha256('hello fin') = %s\n", digest);

    // 2. Authenticate a message with a shared secret.
    let mac <string> = hmac_sha256_hex("s3cr3t", "transfer $100 to eleanor");
    printf("hmac = %s\n", mac);

    // 3. Verify it again (constant-time compare).
    let check <string> = hmac_sha256_hex("s3cr3t", "transfer $100 to eleanor");
    if (const_time_eq(mac, check)) {
        printf("MAC verified\n");
    } else {
        printf("MAC MISMATCH\n");
    }

    // 4. Mint a random session token.
    let token <string> = random_hex(32);
    printf("token = %s\n", token);
}
