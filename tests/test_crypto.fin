// API contract, ownership and comparison tests. Correctness against published
// vectors lives in tests/vectors.fin; this file deliberately does not repeat
// them, so each claim has exactly one home.
//
// Run: finc tests/test_crypto.fin -I src -o test_crypto && ./test_crypto
import { sha256_hex, sha256_bytes, sha256_bytes_hex, hmac_sha256_hex, hmac_sha256_bytes, hmac_sha256_bytes_hex, random_bytes, random_hex, const_time_eq, const_time_eq_bytes } from crypto::fin;
import { assert_true } from testing::std;
import { len, free_str, to_chars, from_chars } from strings::std;
import { hex_encode } from encoding::std;

fun main() <noret> {
    // --- The string APIs hash exactly the bytes before the first NUL, which is
    //     why a string that embeds one must use the byte API instead. ---
    let digest <string> = sha256_hex("hello fin");
    assert_true(digest != null && len(digest) == 64, "sha256_hex returns 64 hex chars");
    free_str(digest);
    // A string is NUL-terminated storage: "a\0b" hashes as "a".
    assert_true(sha256_hex("a\0b") == sha256_hex("a"), "string API stops at the first NUL");

    // --- Byte API: empty input is legal and identical to the string API. ---
    let empty <[char]> = new [char, 0]{};
    assert_true(sha256_bytes_hex(empty, 0) == sha256_hex(""), "empty byte array matches empty string");
    let nothing <string> = hmac_sha256_bytes_hex(empty, 0, empty, 0);
    assert_true(nothing != null && len(nothing) == 64, "HMAC of two empty arrays is still 64 hex chars");
    free_str(nothing);
    delete empty;

    // --- Raw outputs are exactly 32 owned bytes with no trailing sentinel. ---
    let abc <[char]> = to_chars("abc");
    let raw <[char]> = sha256_bytes(abc, 3);
    let raw_mac <[char]> = hmac_sha256_bytes(abc, 3, abc, 3);
    assert_true(raw.length == 32 && raw_mac.length == 32, "raw outputs are exactly 32 bytes");
    delete raw;
    delete raw_mac;
    delete abc;

    // --- Hex and raw agree, so the hex layer cannot hide a wrong digest.
    //     hex_encode is the library's independent encoder, not the one under test. ---
    let bytes <[char]> = to_chars("agreement");
    let raw2 <[char]> = sha256_bytes(bytes, 9);
    let raw2_hex <string> = sha256_bytes_hex(bytes, 9);
    let via_encoding <string> = hex_encode(from_chars(raw2, 0, 32));
    assert_true(via_encoding == raw2_hex, "hex of raw digest equals raw hex API");
    free_str(via_encoding);
    let mac_raw <[char]> = hmac_sha256_bytes(bytes, 9, bytes, 9);
    let mac_hex <string> = hmac_sha256_bytes_hex(bytes, 9, bytes, 9);
    let mac_via <string> = hex_encode(from_chars(mac_raw, 0, 32));
    assert_true(mac_via == mac_hex, "hex of raw MAC equals raw hex API");
    assert_true(hmac_sha256_hex("agreement", "agreement") == mac_hex, "string HMAC equals byte HMAC");
    free_str(mac_via);
    free_str(raw2_hex);
    free_str(mac_hex);
    delete bytes;
    delete raw2;
    delete mac_raw;

    // --- const_time_eq: full scan, length mismatch is false, no timing claim. ---
    assert_true(const_time_eq("abc", "abc"), "const_time_eq equal strings");
    assert_true(!const_time_eq("abc", "abd"), "const_time_eq differing strings");
    assert_true(!const_time_eq("abc", "abcd"), "const_time_eq different lengths");
    assert_true(const_time_eq("", ""), "const_time_eq empty strings");
    assert_true(!const_time_eq("", "a"), "const_time_eq empty against non-empty");
    let x <[char]> = to_chars("same");
    let y <[char]> = to_chars("same");
    let z <[char]> = to_chars("sane");
    assert_true(const_time_eq_bytes(x, y, 4), "const_time_eq_bytes equal");
    assert_true(!const_time_eq_bytes(x, z, 4), "const_time_eq_bytes differ");
    delete x;
    delete y;
    delete z;

    // A mismatch at the last position must still be found: an early-exit
    // comparison that stops at the first difference would pass the tests above.
    let all <[char]> = new [char, 256]{};
    let copy <[char]> = new [char, 256]{};
    for (let i <int> = 0; i < 256; i++) { all[i] = cast<char>(i); copy[i] = cast<char>(i); }
    assert_true(const_time_eq_bytes(all, copy, 256), "all byte values compare equal");
    for (let i <int> = 0; i < 256; i++) {
        copy[i] = cast<char>((i + 1) % 256);
        assert_true(!const_time_eq_bytes(all, copy, 256), "mismatch at each position");
        assert_true(const_time_eq_bytes(all, copy, i), "prefix excludes mismatch");
        copy[i] = all[i];
    }
    delete all;
    delete copy;

    // --- OS random: shape and sentinel only. Shapes prove nothing about
    //     entropy; see README for what is and is not established. ---
    // Counts straddling the Windows four-byte word boundary exercise partial words.
    for (let count <int> = 1; count <= 9; count++) {
        let short_random <[char]> = random_bytes(count);
        assert_true(short_random.length == count + 1 && short_random[count] == cast<char>(0), "random partial-word sentinel");
        delete short_random;
    }
    let r <[char]> = random_bytes(16);
    assert_true(r.length == 17 && r[16] == cast<char>(0), "random_bytes(16) sentinel and length");
    delete r;
    let rh <string> = random_hex(16);
    assert_true(len(rh) == 32, "random_hex(16) is 32 hex chars");
    free_str(rh);
    // count 0 still allocates the sentinel, so the handle is never empty.
    let empty_random <[char]> = random_bytes(0);
    assert_true(empty_random.length == 1 && empty_random[0] == cast<char>(0), "empty random sentinel");
    delete empty_random;
    let empty_hex <string> = random_hex(0);
    assert_true(len(empty_hex) == 0, "empty random hex");
    free_str(empty_hex);

    // Two draws of 32 bytes must differ. A constant or reused buffer would not.
    let a <[char]> = random_bytes(32);
    let b <[char]> = random_bytes(32);
    assert_true(!const_time_eq_bytes(a, b, 32), "two random draws differ");
    delete a;
    delete b;

    printf("all fin-crypto tests passed\n");
}
